<resources>
    <!-- 系统级兜底主题。Compose 内的视觉由 AOSAgentTheme 定义，
         此处只保证启动窗口与系统栏不出现浅色闪屏。 -->
    <!-- NoActionBar：DeviceDefault 默认带浅色 ActionBar，与深色设计冲突，且 Compose 自绘顶栏 -->
    <style name="Theme.AOSAgent" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/aos_bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/aos_bg_primary</item>
    </style>
</resources>
