{
  "_note": "车辆属性 allowlist。唯一事实源：加减字段或换 OEM 只改本文件，不改 Kotlin。protection 取值来自 2026-09-27 在 Automotive 模拟器(API 35) 上 dumpsys package permission 的实测输出；property 是否真的可读由 VehiclePropertyProbeTest 在设备上记录。",
  "properties": [
    {
      "name": "SPEED",
      "category": "CHASSIS_AND_DYNAMICS",
      "permission": "android.car.permission.CAR_SPEED",
      "protection": "dangerous",
      "access": "read",
      "unit": "m/s",
      "description": "当前车速，米每秒。0 表示静止。"
    },
    {
      "name": "EV_BATTERY_LEVEL",
      "category": "ENERGY_MANAGEMENT",
      "permission": "android.car.permission.CAR_ENERGY",
      "protection": "dangerous",
      "access": "read",
      "unit": "Wh",
      "description": "动力电池当前电量，瓦时。"
    },
    {
      "name": "PERCENT_REMAINING_CHARGE",
      "category": "ENERGY_MANAGEMENT",
      "permission": "android.car.permission.CAR_ENERGY",
      "protection": "dangerous",
      "access": "read",
      "unit": "percent",
      "description": "剩余电量百分比，0~100。回答用户'还剩多少电'优先用这个。"
    },
    {
      "name": "ENV_OUTSIDE_TEMPERATURE",
      "category": "HVAC_SYSTEM",
      "permission": "android.car.permission.CAR_EXTERIOR_ENVIRONMENT",
      "protection": "normal",
      "access": "read",
      "unit": "celsius",
      "description": "车外环境温度，摄氏度。"
    },
    {
      "name": "INFO_MODEL",
      "category": "VEHICLE_INFO",
      "permission": "android.car.permission.CAR_INFO",
      "protection": "normal",
      "access": "read",
      "unit": null,
      "description": "车型名称，字符串。"
    },
    {
      "name": "INFO_MAKE",
      "category": "VEHICLE_INFO",
      "permission": "android.car.permission.CAR_INFO",
      "protection": "normal",
      "access": "read",
      "unit": null,
      "description": "制造商名称，字符串。"
    },
    {
      "name": "PROG_DISPLAY_DISTANCE",
      "category": "VEHICLE_INFO",
      "permission": "android.car.permission.CAR_POWERTRAIN",
      "protection": "normal",
      "access": "read",
      "unit": "km",
      "description": "总行驶里程，公里。"
    },
    {
      "name": "TYRE_PRESSURE",
      "category": "CHASSIS_AND_DYNAMICS",
      "permission": "android.car.permission.CAR_TIRES",
      "protection": "signature|privileged",
      "access": "read",
      "unit": "kPa",
      "description": "四轮胎压。普通可安装应用拿不到 CAR_TIRES，保留在此仅用于验证特权字段被跳过。"
    },
    {
      "name": "HVAC_TEMPERATURE_SET",
      "category": "HVAC_SYSTEM",
      "permission": "android.car.permission.CONTROL_CAR_CLIMATE",
      "protection": "signature|privileged",
      "access": "write",
      "unit": "celsius",
      "description": "空调设定温度。写属性一律不注册为工具（本期结构性不可得）。"
    }
  ]
}
